{
  "$schema": "vscode://schemas/color-theme",
  "name": "Asa",
  "colors": {
    "editor.background": "#111010",
    "editor.foreground": "#e7e6e6",
    "titleBar.activeBackground": "#111010",
    "titleBar.inactiveBackground": "#111010",
    "titleBar.activeForeground": "#e7e6e6",
    "titleBar.inactiveForeground": "#8C897C",
    "editorGroupHeader.tabsBackground": "#111010",
    "editorGroupHeader.noTabsBackground": "#111010",
    "editorGroupHeader.tabsBorder": "#111010",
    "tab.activeBackground": "#111010",
    "tab.inactiveBackground": "#111010",
    "tab.activeForeground": "#e7e6e6",
    "tab.inactiveForeground": "#8C897C",
    "tab.border": "#111010",
    "tab.activeBorder": "#C7BCAE",
    "tab.unfocusedActiveBorder": "#111010",
    "sideBar.background": "#111010",
    "sideBar.foreground": "#e7e6e6",
    "activityBar.background": "#111010",
    "activityBar.foreground": "#e7e6e6",
    "activityBar.inactiveForeground": "#8C897C",
    "activityBar.border": "#111010",
    "statusBar.background": "#111010",
    "statusBar.foreground": "#e7e6e6",
    "statusBar.border": "#111010",
    "statusBar.noFolderBackground": "#111010",
    "statusBar.noFolderForeground": "#e7e6e6",
    "statusBar.debuggingBackground": "#111010",
    "statusBar.debuggingForeground": "#e7e6e6",
    "statusBarItem.hoverBackground": "#1A1919",
    "statusBarItem.hoverForeground": "#e7e6e6",
    "statusBarItem.activeBackground": "#1A1919",
    "button.background": "#e7e6e6",
    "button.foreground": "#111010",
    "button.hoverBackground": "#C7BCAE",
    "button.secondaryBackground": "#C7BCAE",
    "button.secondaryForeground": "#111010",
    "button.secondaryHoverBackground": "#AAAAA3",
    "textLink.foreground": "#C7BCAE",
    "textLink.activeForeground": "#D2D1D2",
    "editor.selectionBackground": "#3A3835",
    "editor.selectionForeground": "#e7e6e6",
    "editor.wordHighlightBackground": "#8C897C9c",
    "editor.wordHighlightStrongBackground": "#8C897C9c",
    "editor.hoverHighlightBackground": "#8C897C9c",
    "editorLineNumber.foreground": "#8C897C",
    "editorLineNumber.activeForeground": "#e7e6e6",
    "editorCursor.foreground": "#e7e6e6",
    "focusBorder": "#C7BCAE",
    "contrastBorder": "#111010",
    "contrastActiveBorder": "#C7BCAE",
    "input.background": "#111010",
    "input.foreground": "#e7e6e6",
    "input.border": "#3A3835",
    "input.placeholderForeground": "#8C897C",
    "dropdown.background": "#111010",
    "dropdown.foreground": "#e7e6e6",
    "dropdown.border": "#3A3835",
    "list.activeSelectionBackground": "#3A3835",
    "list.activeSelectionForeground": "#e7e6e6",
    "list.inactiveSelectionBackground": "#292827",
    "list.inactiveSelectionForeground": "#e7e6e6",
    "list.hoverBackground": "#1A1919",
    "list.hoverForeground": "#e7e6e6",
    "menu.background": "#111010",
    "menu.foreground": "#e7e6e6",
    "menu.selectionBackground": "#3A3835",
    "menu.selectionForeground": "#e7e6e6",
    "menu.border": "#3A3835",
    "panel.background": "#111010",
    "panel.border": "#1A1919",
    "terminal.background": "#111010",
    "terminal.foreground": "#e7e6e6",
    "terminalCursor.foreground": "#e7e6e6",
    "terminal.selectionBackground": "#3A3835"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8C897C"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C7BCAE"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#D2D1D2"
      }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#AAAAA3"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#C7BCAE"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#D2D1D2"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#e7e6e6"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C7BCAE"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#AAAAA3"
      }
    }
  ]
}
